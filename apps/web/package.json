{
  "name": "@exchange-chart/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{json,html,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{json,html,ts}\"",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@exchange-chart/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "d3-scale": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.13"
  }
}
