{
  "name": "exchange-chart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @exchange-chart/web dev",
    "dev:api": "pnpm --filter @exchange-chart/api dev",
    "build": "pnpm run build:shared && pnpm run build:web && pnpm run build:api",
    "build:web": "pnpm --filter @exchange-chart/web build",
    "build:api": "pnpm --filter @exchange-chart/api build",
    "build:shared": "pnpm --filter @exchange-chart/shared build",
    "preview": "pnpm --filter @exchange-chart/web preview",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "deploy": "pnpm --filter @exchange-chart/web deploy"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
